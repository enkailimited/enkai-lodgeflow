# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# GATE 2.0 — ROOM INVENTORY (PostgreSQL)
# Server-only. Never prefix these with VITE_: anything VITE_* is bundled into
# the browser.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by the Express server and the migration
# runner. Example only — never commit a real credential.
# Neon: use the pooled endpoint (hostname contains "-pooler") for the app.
DATABASE_URL="postgres://user:password@localhost:5432/enkai_lodgeflow"

# Neon direct (unpooled) endpoint, used by `npm run db:migrate` for DDL and
# advisory locks. Falls back to DATABASE_URL when unset.
DATABASE_URL_UNPOOLED=""

# Optional TLS mode for managed PostgreSQL hosts:
#   (unset) / "disable" -> plain connection
#   "require"           -> TLS with certificate verification
#   "no-verify"         -> TLS without certificate verification
PGSSL=""

# Neon can suspend an idle compute; allow a cold start before failing.
# PG_CONNECT_TIMEOUT_MS="20000"

# Temporary operator gate for destructive room operations (room/category
# deletion) and the one-time local inventory import. Leave empty to disable
# those routes entirely. This is NOT staff authentication; D11 sessions replace
# it in a later gate.
ROOM_ADMIN_TOKEN=""
